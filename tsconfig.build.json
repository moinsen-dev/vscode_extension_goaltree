{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Build Optimizations */
    "removeComments": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    
    /* Build Performance */
    "incremental": true,
    "tsBuildInfoFile": "./out/.tsbuildinfo",
    
    /* Production Safety */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    
    /* Build Specific Output */
    "outDir": "./out",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules/**/*",
    ".vscode-test/**/*",
    "out/**/*",
    "dist/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/test/**/*"
  ]
}